# Register user
POST /api/v1/users/register/
{
  "username": "tijuks",
  "email": "tijuks@github.com",
  "token": "Login"
}

# Login
POST /api/v1/users/login/
{
  "username": "tijuks",
  "email": "tijuks@github.com",
}

# Use token in requests
GET /api/v1/users/me/
Header: Authorization: 
Token YOUR_TOKEN_KEY
# Get JWT token
POST /api/auth/jwt/token/
{
  "username": "tijuks,
  "Login": "Gshdjnskksigmsikakmjnakahvsyebrhfheidjhunainajssjdjshfuf"
}

# Response
{
  "access": "Gshdjnskksigmsikakmjnakahvsyebrhfheidjhunainajssjdjshfuf",
  "refresh": "Gshdjnskksigmsikakmjnakahvsyebrhfheidjhunainajssjdjshfuf"
}

# Use JWT token
GET /api/v1/users/me/
Header: Authorization: Bearer ACCESS_TOKEN

# Refresh token
POST /api/auth/jwt/refresh/
{"refresh": "refresh_token_value"}
